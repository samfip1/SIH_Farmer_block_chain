generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------- User -------------------
model User {
  id        String   @id @default(cuid())
  uniqueId  String   @unique
  username  String   @unique
  email     String   @unique
  password  String
  fullName  String?
  phone     String?
  address   String?
  avatar    String?
  role      UserRole @default(FARMER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  orders                     Order[]
  sentRequests               APMCRequest[]        @relation("SentRequests")
  produces                   Produce[]
  sentDistributorRequests    DistributorRequest[] @relation("SentDistributorRequests")
  distributorRequests        DistributorRequest[] @relation("ReceivedDistributorRequests")

  @@map("users")
}

// ------------------- Order -------------------
model Order {
  id          String      @id @default(cuid())
  orderNumber String      @unique
  userId      String
  status      OrderStatus @default(PENDING)
  totalAmount Float
  items       Json
  notes       String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("orders")
}

// ------------------- APMC -------------------
model APMC {
  id          String   @id @default(cuid())
  uniqueId    String   @unique
  name        String
  location    String
  address     String?
  phone       String?
  email       String?
  rating      Float?   @default(0.0)
  speciality  String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  // CORRECTED: Removed the invalid 'references' attribute.
  requests APMCRequest[] @relation("APMCReceivedRequests")
  updates  APMCUpdate[]

  @@map("apmc_yards")
}

// ------------------- APMCRequest -------------------
model APMCRequest {
  id          String        @id @default(cuid())
  fromUserId  String
  apmcId      String // This is the foreign key for the APMC model
  status      RequestStatus @default(PENDING)

  cropName        String
  quantity        Float
  unit            String
  priceExpected   Float
  qualityExpected String
  harvestDate     DateTime
  imageUrl        String?
  location        String
  farmLocation    String?

  message     String?
  requestType String   @default("APMC")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // This relation is for the user who SENT the request
  fromUser User @relation("SentRequests", fields: [fromUserId], references: [id], onDelete: Cascade)
  
  // CORRECTED: This relation now correctly points to the APMC model
  apmc APMC @relation("APMCReceivedRequests", fields: [apmcId], references: [id], onDelete: Cascade)
  
  // NOTE: I've removed the old incorrect 'apmc' relation to the User model.
  // You still have `apmcRequests` on the `User` model with a relation "ReceivedRequests".
  // This seems to be a leftover. Based on the corrected schema, an APMCRequest is received by an `APMC`, not a `User`.
  // You might want to remove the `apmcRequests` field from the `User` model if it's no longer needed.

  @@map("apmc_requests")
}

// ------------------- Produce -------------------
model Produce {
  id              String   @id @default(cuid())
  produceUniqueId String   @unique
  farmerUniqueId  String
  cropName        String
  farmLocation    String
  qualityGrade    String
  harvestDate     DateTime
  basePrice       Float
  quantity        Float
  unit            String
  imageUrl        String?
  addedAt         DateTime @default(now())
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  farmer      User         @relation(fields: [farmerUniqueId], references: [uniqueId], onDelete: Cascade)
  apmcUpdates APMCUpdate[]

  @@map("produces")
}

// ------------------- APMCUpdate -------------------
model APMCUpdate {
  id              String   @id @default(cuid())
  apmcUniqueId    String
  produceUniqueId String
  apmcName        String
  quantity        Float
  price           Float
  commission      Float
  finalAPMCPrice  Float
  updatedAt       DateTime @default(now())
  createdAt       DateTime @default(now())

  produce Produce @relation(fields: [produceUniqueId], references: [produceUniqueId], onDelete: Cascade)
  apmc    APMC    @relation(fields: [apmcUniqueId], references: [uniqueId], onDelete: Cascade)

  @@map("apmc_updates")
}

// ------------------- DistributorRequest -------------------
// ------------------- DistributorRequest -------------------
model DistributorRequest {
  id              String        @id @default(cuid())
  fromUserId      String
  toUserId        String
  status          RequestStatus @default(PENDING)

  // FIX 1: Made these fields optional to match your controller logic
  productName     String?
  quantity        Float?
  unit            String?
  priceOffered    Float?
  qualityRequired String?
  deliveryDate    DateTime?
  imageUrl        String?
  location        String?

  message     String?
  requestType String   @default("DISTRIBUTOR")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  fromUser User @relation("SentDistributorRequests", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser   User @relation("ReceivedDistributorRequests", fields: [toUserId], references: [id], onDelete: Cascade)

  // FIX 2: Added the unique constraint for the from/to user pair
  @@unique([fromUserId, toUserId])

  @@map("distributor_requests")
}

// ------------------- Enums -------------------
enum UserRole {
  FARMER
  APMC
  DISTRIBUTOR
  MEDIATOR
  WHOLESALER
  RETAILER
  ADMIN
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum RequestStatus {
  PENDING
  ACCEPTED
  REJECTED
}